# ==============================================================================
# NEARVIA Express REST API Gateway Environment Configuration Template
# KEEP ALL VALUES SECURE - NEVER EXPOSE TO CLIENT BROWSERS
# ==============================================================================

# 1. Server Runtime Configuration
NODE_ENV=development
PORT=4000
API_HOST=localhost
API_BASE_URL=http://localhost:4000

# CORS Whitelist (comma-separated origins)
# Dev: http://localhost:3000,http://localhost:5173,http://localhost:5174
# Prod: https://nearvia.in,https://app.nearvia.in,https://admin.nearvia.in
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# 2. Database & PostGIS Connection (Supabase PostgreSQL 15+ with PostGIS 3.3)
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# 3. Supabase Configuration (Auth & Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-Side Only: Service Role Key (CRITICAL: NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# 4. Payment Gateway (Razorpay)
# Mode: 'demo' (mock) | 'sandbox' (test mode) | 'production' (live)
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 5. SMS & OTP Verification
# Mode: 'mock' (dev/test only) | 'msg91' (DLT SMS in production)
OTP_PROVIDER=mock
ALLOW_MOCK_OTP_IN_PRODUCTION=false
OTP_SALT=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=NRVIA
MSG91_API_URL=https://control.msg91.com/api/v5/otp

# 6. Intelligence & Matching
AI_PROVIDER=mock
GEMINI_API_KEY=

# 7. Geospatial & Hyperlocal Defaults
MAP_DEFAULT_RADIUS_KM=5
MAP_MAX_RADIUS_KM=15
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# 8. Demo Controls (Must be false in production)
ALLOW_DEMO_SEED_IN_PROD=false
ALLOW_DEMO_RESET_IN_PROD=false
DEMO_PASSWORD=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
