# ==============================================================================
# NEARVIA Admin Console Client Environment Configuration Template
# All browser-accessible variables MUST be prefixed with VITE_
# DO NOT place backend secrets, service role keys, or database credentials here.
# ==============================================================================

# API Base URL
# Dev: http://localhost:4000/api/v1
# Prod: https://api.nearvia.in/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase Public Client (Safe for browser bundle - strictly authenticated via ADMIN role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
