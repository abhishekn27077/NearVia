# ==============================================================================
# NEARVIA Web Frontend Client Environment Configuration Template
# All browser-accessible variables MUST be prefixed with VITE_
# DO NOT place backend secrets, service role keys, or database credentials here.
# ==============================================================================

# API Base URL (Relative /api/v1 for reverse-proxy or full URL for cross-domain)
# Dev: http://localhost:4000/api/v1
# Prod: https://api.nearvia.in/api/v1 (or /api/v1 if behind CDN/reverse proxy)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Branding & Localization
VITE_APP_NAME=NEARVIA
VITE_APP_TAGLINE="Work Within Reach"
VITE_DEFAULT_RADIUS_KM=5

# Supabase Public Client (Safe for browser bundle - restricted by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Demo Accounts Toggle (Strictly disabled in production builds)
# Set to 'true' only on internal QA/demo environments
VITE_ENABLE_DEMO_ACCOUNTS=false
VITE_DEMO_PASSWORD=your-local-demo-password-here
