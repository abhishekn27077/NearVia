# ==============================================================================
# NEARVIA - Environment Configuration Template
# Tagline: Work Within Reach | Hyperlocal Quick-Work Marketplace
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env in your local environment or configure via
#    your deployment platform's secret manager (e.g. Render, Railway, AWS ECS).
# 2. NEVER commit real credentials, database passwords, or private keys to git.
# 3. Only variables prefixed with VITE_ are bundled into frontend web artifacts.
#    All backend secrets (DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, etc.) must remain server-side.
# ==============================================================================

# ==============================================================================
# 1. SERVER & RUNTIME CONFIGURATION
# ==============================================================================
# Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# API Port & Host
PORT=4000
API_HOST=localhost
API_BASE_URL=http://localhost:4000

# CORS Whitelist (comma-separated origins)
# Dev: http://localhost:3000,http://localhost:5173,http://localhost:5174
# Staging: https://staging.nearvia.in,https://admin-staging.nearvia.in
# Production: https://nearvia.in,https://app.nearvia.in,https://admin.nearvia.in
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging Level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# ==============================================================================
# 2. DATABASE & POSTGIS CONFIGURATION
# ==============================================================================
# PostgreSQL 15+ with PostGIS 3.3+ enabled
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# ==============================================================================
# 3. SUPABASE (AUTH & STORAGE) CONFIGURATION
# ==============================================================================
# Project URL & Public Anon Key
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-Side Only: Service Role Key (NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ==============================================================================
# 4. PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
# Payment Mode: 'demo' (in-memory mock) | 'sandbox' (Razorpay test mode) | 'production' (Razorpay live)
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# 5. SMS & OTP VERIFICATION CONFIGURATION
# ==============================================================================
# OTP Provider: 'mock' (in-memory, code logged to server console) | 'msg91' (production DLT SMS)
OTP_PROVIDER=mock
ALLOW_MOCK_OTP_IN_PRODUCTION=false
OTP_SALT=

# MSG91 Credentials (Required when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=NRVIA
MSG91_API_URL=https://control.msg91.com/api/v5/otp

# ==============================================================================
# 6. INTELLIGENCE & AI LAYER CONFIGURATION
# ==============================================================================
# AI Provider: 'mock' (deterministic regex/heuristics) | 'gemini' | 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=

# ==============================================================================
# 7. CACHE & RATE LIMITING (DISTRIBUTED PRODUCTION)
# ==============================================================================
REDIS_URL=

# ==============================================================================
# 8. HYPERLOCAL & GEOSPATIAL PARAMETERS
# ==============================================================================
MAP_DEFAULT_RADIUS_KM=5
MAP_MAX_RADIUS_KM=15
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# ==============================================================================
# 9. FRONTEND CLIENT CONFIGURATION (apps/web/.env)
# ==============================================================================
# These variables MUST be prefixed with VITE_ to be visible in browser code
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME="NEARVIA"
VITE_APP_TAGLINE="Work Within Reach"
VITE_DEFAULT_RADIUS_KM=5
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# 10. ADMIN CONSOLE CLIENT CONFIGURATION (apps/admin/.env)
# ==============================================================================
# Dedicated Admin Console running on port 5174
# VITE_API_BASE_URL=http://localhost:4000
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
