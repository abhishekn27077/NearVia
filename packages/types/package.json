{
  "name": "@nearvia/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain types, enums, and interfaces for NEARVIA",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
