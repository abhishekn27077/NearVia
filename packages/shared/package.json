{
  "name": "@nearvia/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Truly generic utility functions for NEARVIA",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@nearvia/types",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nearvia/types": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
